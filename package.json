{
  "name": "nickflix",
  "version": "1.0.0",
  "description": "NickFlix — Screen 1: watch movies from your own PC together, in sync.",
  "type": "module",
  "main": "server/index.js",
  "license": "MIT",
  "author": "Nick",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "check": "node --check server/index.js && node --check host/src/index.js",
    "host": "cd host && npm install --omit=dev --no-audit --no-fund && node src/index.js"
  },
  "dependencies": {
    "compression": "^1.8.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "socket.io": "^4.8.1",
    "video.js": "8.24.2",
    "hls.js": "1.7.3"
  }
}
